<Window x:Class="PropertyManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PropertyManager.Views"
        Title="Property Manager"
        Height="877"
        Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   Margin="0,0,0,20"
                   FontSize="24"
                   FontWeight="Bold"
                   Text="Property Manager"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="User name:"/>

        <TextBox Grid.Row="1"
                 Grid.Column="1"
                 Margin="8,4"
                 Text="{Binding UserName,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="Counter:"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Margin="8,4"
                   FontSize="16"
                   Text="{Binding Counter}"/>

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="Temperature:"/>

        <StackPanel Grid.Row="3"
                    Grid.Column="1"
                    Margin="8,4">

            <Slider Minimum="15"
                    Maximum="35"
                    Value="{Binding Temperature, Mode=TwoWay}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"/>

            <TextBlock HorizontalAlignment="Center"
                       Text="{Binding Temperature,
                                      StringFormat={}{0:F1} °C}"/>
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="Enabled:"/>

        <CheckBox Grid.Row="4"
                  Grid.Column="1"
                  Margin="8,4"
                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                  Content="Enable property monitoring"/>

        <TextBlock Grid.Row="5"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="Status:"/>

        <TextBlock Grid.Row="5"
                   Grid.Column="1"
                   Margin="8,4"
                   Text="{Binding Status}"/>

        <StackPanel Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Margin="0,24,0,0">

            <TextBlock Margin="0,0,0,12"
                       Text="{Binding LastUpdated,
                                      StringFormat=Last updated: {0:G}}"/>

            <StackPanel Orientation="Horizontal">
                <Button Width="120"
                        HorizontalAlignment="Left"
                        Command="{Binding ResetCommand}"
                        Content="Reset values"/>

                <Button Width="120" HorizontalAlignment="Left"
                        Margin="8,0,0,0"
                        Command="{Binding ConnectCommand}"
                        Content="Connect"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="7" 
              Grid.ColumnSpan="2"
              Margin="0,16,0,0"
              RowDefinitions="30 Auto"
              ColumnDefinitions="* Auto">

            <TextBox Grid.Row="0" Grid.Column="0"
                     Margin="0,0,8,8"
                     MinHeight="30"
                     VerticalContentAlignment="Center"
                     Text="{Binding ArduinoCommand,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Example: !GET_NeoPixels:1"/>

            <Button Grid.Row="0" Grid.Column="1"
                    Width="120"
                    Height="30"
                    Command="{Binding SendCommand}"
                    Content="Send command"/>

            <TextBox Grid.Row="1" Grid.ColumnSpan="2"
                     MinHeight="140"
                     IsReadOnly="True"
                     AcceptsReturn="False"
                     IsUndoEnabled="False"
                     Text="{Binding ReceivedData, Mode=OneWay}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Visible"
                     HorizontalScrollBarVisibility="Auto"/>
        </Grid>

        <views:NeoPixelView Grid.Row="7"
                    Grid.ColumnSpan="2"
                    DataContext="{Binding NeoPixels}" Margin="0,194,0,0" Grid.RowSpan="2"/>
    </Grid>


</Window>
