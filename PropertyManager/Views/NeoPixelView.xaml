<UserControl x:Class="PropertyManager.Views.NeoPixelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             >

    <Grid RowDefinitions="Auto *">

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,12">

            <Button Width="110"
                    Margin="0,0,8,0"
                    Command="{Binding AddPixelCommand}"
                    Content="Add pixel"/>

            <Button Width="110"
                    Margin="0,0,8,0"
                    Command="{Binding RemovePixelCommand}"
                    Content="Remove pixel"/>

            <Button Width="110"
                    Command="{Binding SendPixelsCommand}"
                    Content="Send to Arduino"/>
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Pixels}"
                 SelectedItem="{Binding SelectedPixel, Mode=TwoWay}"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            
            <!--<ItemsControl.ItemsPanel>
                <ItemsPanelTemplate >
                    <WrapPanel IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>-->

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="2"
                            Padding="8"
                            BorderBrush="Gray"
                            BorderThickness="1">

                        <Grid ColumnDefinitions="60 * * * * Auto">

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Index,
                                                      StringFormat=Pixel {0}}"/>

                            <StackPanel Grid.Column="1"
                                        Margin="4,0">
                                <TextBlock Text="Red"/>
                                <Slider Maximum="255" 
                                        Orientation="Vertical" Height="40"
                                        Value="{Binding Red, Mode=TwoWay}"/>
                                <TextBlock HorizontalAlignment="Center"
                                           Text="{Binding Red}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="4,0">
                                <TextBlock Text="Green"/>
                                <Slider Maximum="255"
                                        Orientation="Vertical" Height="40"
                                        Value="{Binding Green, Mode=TwoWay}"/>
                                <TextBlock HorizontalAlignment="Center"
                                           Text="{Binding Green}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                        Margin="4,0">
                                <TextBlock Text="Blue"/>
                                <Slider Maximum="255"
                                        Orientation="Vertical" Height="40"
                                        Value="{Binding Blue, Mode=TwoWay}"/>
                                <TextBlock HorizontalAlignment="Center"
                                           Text="{Binding Blue}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4"
                                        Margin="4,0">
                                <TextBlock Text="Brightness"/>
                                <Slider Maximum="255"
                                        Orientation="Vertical" Height="40"
                                        Value="{Binding Brightness, Mode=TwoWay}"/>
                                <TextBlock HorizontalAlignment="Center"
                                           Text="{Binding Brightness}"/>
                            </StackPanel>

                            <CheckBox Grid.Column="5"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding Enabled}"
                                      Content="On"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>